{
  "uid": "events-manager",
  "title": "Events Manager",
  "tags": ["events-manager"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95 by route",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*|/swagger-ui.*|/v3/api-docs.*\"}[1m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "scaleDistribution": { "type": "log", "log": 10 } } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "k6 (client): p95 / p99 latency by route",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "k6_http_req_duration_p95{scenario=\"browse\"}", "legendFormat": "p95 {{name}}" },
        { "refId": "B", "expr": "k6_http_req_duration_p99{scenario=\"browse\"}", "legendFormat": "p99 {{name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Listing cache: hit ratio",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_gets_total{cache=\"events-listing\",result=\"hit\"}[1m])) / sum(rate(cache_gets_total{cache=\"events-listing\",result=~\"hit|miss\"}[1m]))",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Traffic and errors",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "panels": [
        {
          "id": 1,
          "type": "stat",
          "title": "Scrape target",
          "gridPos": { "h": 8, "w": 4, "x": 0, "y": 9 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "up{job=\"events-manager\"}", "instant": true }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
              ]
            },
            "overrides": []
          },
          "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
        },
        {
          "id": 2,
          "type": "timeseries",
          "title": "Requests per second by route",
          "gridPos": { "h": 8, "w": 10, "x": 4, "y": 9 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
              "legendFormat": "{{uri}}"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
        },
        {
          "id": 3,
          "type": "timeseries",
          "title": "Error ratio (5xx)",
          "gridPos": { "h": 8, "w": 10, "x": 14, "y": 9 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "(sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
              "legendFormat": "5xx"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
        },
        {
          "id": 5,
          "type": "timeseries",
          "title": "Latency p50 (all routes)",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
              "legendFormat": "p50"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "JVM and connection pool",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": [
        {
          "id": 6,
          "type": "timeseries",
          "title": "JVM heap",
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
            { "refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
          ],
          "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
        },
        {
          "id": 7,
          "type": "timeseries",
          "title": "GC pause time per second",
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))", "legendFormat": "GC pause" }
          ],
          "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Hikari connections",
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active" },
            { "refId": "B", "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
            { "refId": "C", "expr": "hikaricp_connections_max", "legendFormat": "max" }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "k6 load generator",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "panels": [
        {
          "id": 10,
          "type": "timeseries",
          "title": "k6 (client): requests per second",
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "sum(rate(k6_http_reqs_total{scenario=\"browse\"}[1m]))", "legendFormat": "requests" }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "k6 (client): failed requests",
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "max(k6_http_req_failed_rate{scenario=\"browse\"})", "legendFormat": "failed" }
          ],
          "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
        },
        {
          "id": 12,
          "type": "timeseries",
          "title": "k6 (client): virtual users",
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "k6_vus", "legendFormat": "VUs" }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
        }
      ]
    }
  ]
}

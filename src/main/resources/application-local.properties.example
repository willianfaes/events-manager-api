# Two values need setting here — url/username are already
# correct for local (see application.properties) and don't need to
# be duplicated. Keep this password in sync with .env's DB_PASSWORD.
spring.datasource.password=changeme

# Secret used to sign JWTs. Must have at least 32 bytes; the app refuses to start otherwise.
# Generate one with: openssl rand -base64 32
jwt.secret=change.me-not-32-bytes
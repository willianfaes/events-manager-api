DB_NAME=events_manager_db
DB_USER=events_manager_app
DB_PASSWORD=changeme
# At least 32 bytes, e.g. from: openssl rand -base64 32
JWT_SECRET=change.me-not-32-bytes
# Issuer of the Cognito user pool: `terraform output cognito_issuer_uri` in infra/ (a public URL, not a secret)
COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# Admin password of the Grafana UI (only used with the `monitoring` profile)
GRAFANA_PASSWORD=changeme
# Listing cache: `redis` (default) or `none` to measure without it (e.g. the k6 comparison)
CACHE_TYPE=redis

DB_NAME=events_manager_db
DB_USER=events_manager_app
DB_PASSWORD=changeme
# The project's Cognito user pool. These are public values, not secrets: `terraform output` in infra/ prints the
# same ones. Replace them only if you run your own pool.
COGNITO_ISSUER_URI=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_3VrOILR4Y
# Optional, for the login button in Swagger UI (the client id is also needed by the k6 load test)
COGNITO_HOSTED_UI_URL=https://events-manager-164106395660.auth.eu-north-1.amazoncognito.com
COGNITO_CLIENT_ID=v4gdb6t181545k46nd74lpi9t
# Optional, gives the demo user a profile with coordinates on startup (empty skips it): `terraform output demo_user_sub`
DEMO_USER_SUB=903ce90c-40e1-7076-a74b-f54e6502b55e
# Admin password of the Grafana UI (only used with the `monitoring` profile)
GRAFANA_PASSWORD=changeme
# Listing cache: `redis` (default) or `none` to measure without it (e.g. the k6 comparison)
CACHE_TYPE=redis
# k6 load test only: the same value as `load_test_password` in infra/terraform.tfvars, and the client that
# `terraform output load_test_client_id` prints while it is set
LOAD_TEST_PASSWORD=changeme
LOAD_TEST_CLIENT_ID=
